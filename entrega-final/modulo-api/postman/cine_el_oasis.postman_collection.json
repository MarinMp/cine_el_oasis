    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "admin_usuario",
      "value": ""
    },
    {
      "key": "admin_clave",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "id_venta",
      "value": ""
    }
  ],
