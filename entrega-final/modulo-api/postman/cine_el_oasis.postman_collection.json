    {
      "name": "Transaccion cruzada: compra en linea (PostgreSQL + MongoDB)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201', () => pm.response.to.have.status(201));",
              "const r = pm.response.json();",
              "pm.collectionVariables.set('id_venta', r.id_venta);",
              "pm.test('El trigger asigno el precio de cada boleta', () => r.detalle.forEach(d => pm.expect(d.precio_unitario).to.eql(d.precio_base)));",
              "pm.test('El trigger calculo el total: 2 x 22.000 + 16.000', () => pm.expect(r.total).to.eql(60000));",
              "pm.test('La auditoria registro 1 insercion y 2 actualizaciones', () => {",
              "    pm.expect(r.auditoria.INSERT).to.eql(1);",
              "    pm.expect(r.auditoria.UPDATE).to.eql(2);",
              "});",
              "pm.test('Guardo el comprobante en MongoDB', () => {",
              "    pm.expect(r.mongodb.coleccion).to.eql('comprobantes_venta');",
              "    pm.expect(r.mongodb.id).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
