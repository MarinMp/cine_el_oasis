{
  "info": {
    "name": "Cine El Oasis API",
    "description": "Pruebas de la API del Cine El Oasis (FastAPI + PostgreSQL en Neon + MongoDB Atlas). Antes de ejecutarla, encender la API con: uvicorn main:app --reload",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "id_venta",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Salud de las bases",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('PostgreSQL conectado con 30 peliculas', () => {",
              "    pm.expect(r.postgresql.estado).to.eql('ok');",
              "    pm.expect(r.postgresql.peliculas).to.eql(30);",
              "});",
              "pm.test('MongoDB conectado con 30 fichas tecnicas', () => {",
              "    pm.expect(r.mongodb.estado).to.eql('ok');",
              "    pm.expect(r.mongodb.fichas_tecnicas).to.eql(30);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/salud",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "salud"
          ]
        },
        "description": "Comprueba la conexion con PostgreSQL y MongoDB."
      },
      "response": []
    },
    {
      "name": "Catalogo completo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('Devuelve las 30 peliculas del catalogo', () => pm.expect(r).to.have.lengthOf(30));",
              "pm.test('Cada pelicula trae genero y clasificacion', () => {",
              "    r.forEach(p => pm.expect(p).to.include.keys('id_pelicula', 'titulo', 'genero', 'clasificacion', 'en_cartelera'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/peliculas",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "peliculas"
          ]
        },
        "description": "Las 30 peliculas, primero las que estan en cartelera."
      },
      "response": []
    },
    {
      "name": "Cartelera",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('Devuelve las 10 peliculas con funciones', () => pm.expect(r).to.have.lengthOf(10));",
              "pm.test('Todas estan en cartelera', () => r.forEach(p => pm.expect(p.en_cartelera).to.be.true));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/peliculas?en_cartelera=true",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "peliculas"
          ],
          "query": [
            {
              "key": "en_cartelera",
              "value": "true"
            }
          ]
        },
        "description": "Solo las peliculas con funciones programadas."
      },
      "response": []
    },
    {
      "name": "Detalle de pelicula (PostgreSQL + MongoDB)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('Es Dune', () => pm.expect(r.titulo).to.eql('Dune'));",
              "pm.test('Trae sus funciones desde PostgreSQL', () => pm.expect(r.funciones).to.be.an('array').that.is.not.empty);",
              "pm.test('Trae su ficha tecnica desde MongoDB', () => {",
              "    pm.expect(r.ficha_tecnica).to.be.an('object');",
              "    pm.expect(r.ficha_tecnica.id_pelicula).to.eql(r.id_pelicula);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/peliculas/1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "peliculas",
            "1"
          ]
        },
        "description": "Une los datos de PostgreSQL con la ficha tecnica de MongoDB por id_pelicula."
      },
      "response": []
    },
    {
      "name": "Pelicula inexistente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 404', () => pm.response.to.have.status(404));",
              "pm.test('Explica el error', () => pm.expect(pm.response.json().detail).to.eql('Pelicula no encontrada'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/peliculas/999",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "peliculas",
            "999"
          ]
        },
        "description": "Caso de error: el id no existe."
      },
      "response": []
    },
    {
      "name": "Id no valido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 422', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/peliculas/abc",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "peliculas",
            "abc"
          ]
        },
        "description": "Caso de error: el id no es un numero."
      },
      "response": []
    },
    {
      "name": "Funcion con boletas y requisitos (PostgreSQL + MongoDB)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('Trae los 3 tipos de boleta de su sala', () => pm.expect(r.tipos_boleta).to.have.lengthOf(3));",
              "pm.test('Calcula las sillas disponibles', () => pm.expect(r.disponibles).to.eql(r.capacidad - r.vendidas));",
              "pm.test('Trae los requisitos de proyeccion desde MongoDB', () => pm.expect(r.proyeccion.formato).to.eql(r.tipo_sala));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/funciones/3",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "funciones",
            "3"
          ]
        },
        "description": "Funcion 3 (Dune, sala 3D). Los requisitos vienen de la coleccion requisitos_proyeccion."
      },
      "response": []
    },
    {
      "name": "Compra en linea",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201', () => pm.response.to.have.status(201));",
              "const r = pm.response.json();",
              "pm.collectionVariables.set('id_venta', r.id_venta);",
              "pm.test('El trigger asigno el precio de cada boleta', () => r.detalle.forEach(d => pm.expect(d.precio_unitario).to.eql(d.precio_base)));",
              "pm.test('El trigger calculo el total: 2 x 22.000 + 16.000', () => pm.expect(r.total).to.eql(60000));",
              "pm.test('La auditoria registro 1 insercion y 2 actualizaciones', () => {",
              "    pm.expect(r.auditoria.INSERT).to.eql(1);",
              "    pm.expect(r.auditoria.UPDATE).to.eql(2);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/ventas",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "ventas"
          ]
        },
        "description": "Registra una compra real en PostgreSQL. Si el documento no existe, registra al espectador.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_funcion\": 3,\n  \"medio_pago\": \"TARJETA DEBITO\",\n  \"comprador\": {\n    \"documento\": \"1001001001\",\n    \"id_tipo_documento\": 1,\n    \"primer_nombre\": \"Prueba\",\n    \"primer_apellido\": \"Postman\",\n    \"correo\": \"prueba.postman@eloasis.co\"\n  },\n  \"boletas\": [\n    {\n      \"id_tipo_boleta\": 4,\n      \"cantidad\": 2\n    },\n    {\n      \"id_tipo_boleta\": 5,\n      \"cantidad\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Consultar la venta",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "pm.test('Es la venta que se acaba de registrar', () => pm.expect(pm.response.json().id_venta).to.eql(Number(pm.collectionVariables.get('id_venta'))));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/ventas/{{id_venta}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "ventas",
            "{{id_venta}}"
          ]
        },
        "description": "Consulta el comprobante de la venta anterior."
      },
      "response": []
    },
    {
      "name": "Rechazo del trigger: mas de 10 boletas",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 409', () => pm.response.to.have.status(409));",
              "const r = pm.response.json();",
              "pm.test('Lo rechazo un trigger', () => pm.expect(r.detail.origen).to.eql('trigger'));",
              "pm.test('Explica el maximo de 10 boletas', () => pm.expect(r.detail.mensaje).to.include('maximo de 10 boletas'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/ventas",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "ventas"
          ]
        },
        "description": "6 + 5 boletas en la misma compra: trg_detalle_venta_boleta la rechaza y no se guarda nada.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_funcion\": 3,\n  \"medio_pago\": \"TARJETA DEBITO\",\n  \"comprador\": {\n    \"documento\": \"1001001001\"\n  },\n  \"boletas\": [\n    {\n      \"id_tipo_boleta\": 4,\n      \"cantidad\": 6\n    },\n    {\n      \"id_tipo_boleta\": 5,\n      \"cantidad\": 5\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
