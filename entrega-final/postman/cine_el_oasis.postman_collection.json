    {
      "name": "Descuento del miercoles",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201', () => pm.response.to.have.status(201));",
              "const r = pm.response.json();",
              "pm.test('El trigger aplico el 50 %: 38.000 -> 19.000', () => pm.expect(r.detalle[0].precio_unitario).to.eql(19000));",
              "pm.test('Marca el descuento', () => pm.expect(r.descuento_miercoles).to.be.true);"
            ]
          }
        }
      ],
